# Copy this to .env for local (non-Docker) runs, or transfer these
# values into the "environment:" block of docker-compose.yml / the
# Portainer stack editor's environment variables.

PORT=8787

# Your self-hosted Ollama instance.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional: Google Gemini as an alternative AI provider for the quote
# summary draft. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SMTP relay for sending quote emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SwyfTech LLC <quotes@swyftech.example>"
# Optional: bcc yourself on every quote email sent.
MAIL_BCC=
